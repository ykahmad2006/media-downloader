{$DOMAIN:localhost} {
	# Hide the server banner
	header -Server

	# Compress pages and data only. Never compress downloads: video and audio are already
	# compressed, and compressing hides the file size, so the browser loses its progress bar.
	encode zstd gzip {
		match {
			header Content-Type text/*
		}
	}

	# Photo uploads for "tweet over a photo" may be up to 16 MB ...
	@upload path /api/overlay
	handle @upload {
		request_body {
			max_size 16MB
		}
		reverse_proxy app:8000 {
			health_uri /healthz
			health_interval 30s
		}
	}

	# ... everything else is a few bytes of JSON
	handle {
		request_body {
			max_size 16KB
		}
		reverse_proxy app:8000 {
			health_uri /healthz
			health_interval 30s
		}
	}
}
