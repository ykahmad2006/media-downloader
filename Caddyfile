{$DOMAIN:localhost} {
	# Hide the server banner and refuse oversized requests (the site only sends tiny JSON)
	header -Server
	request_body {
		max_size 16KB
	}

	# Compress pages and data only. Never compress downloads: video and audio are already
	# compressed, and compressing hides the file size, so the browser loses its progress bar.
	encode zstd gzip {
		match {
			header Content-Type text/*
		}
	}

	# Caddy passes the visitor's real IP and https status to the app (app.py trusts one proxy).
	# Downloads are short requests now, so the default timeouts are fine.
	reverse_proxy app:8000 {
		health_uri /healthz
		health_interval 30s
	}
}
