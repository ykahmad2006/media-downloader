# Copy this file to ".env" on the server (docker compose reads it by itself).
# Never commit the real .env.

# Your domain: its A record must point at this server
DOMAIN=fetchly.example.com

# The same domain with https. Used in link previews, canonical links and the sitemap.
SITE_URL=https://fetchly.example.com

# Passcode for the TOOL (the pages anyone may read stay open for link previews and search engines).
# Use a long one, a phrase of 4 or 5 words. Leave empty for a public tool.
ACCESS_CODE=

# Sites accepted. Leave empty for YouTube, X, TikTok and Instagram only.
# Use * to accept any public site (not recommended)
ALLOWED_HOSTS=

# Launch day settings (see LAUNCH_CHECKLIST.md). All optional.
GSC_VERIFY=
BING_VERIFY=
GTM_ID=
GA_ID=
CONTACT_EMAIL=
