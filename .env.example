# Copy this file to ".env" on the server (docker compose reads it by itself).
# Never commit the real .env.

# Your domain: its A record must point at this server
DOMAIN=fetchly.example.com

# Passcode for the whole site. Use a long one (a phrase of 4 or 5 words). Leave empty for a public site.
ACCESS_CODE=

# Sites accepted. Leave empty for YouTube, X, TikTok and Instagram only.
# Example: ALLOWED_HOSTS=youtube.com,youtu.be
# Use * to accept any public site (not recommended)
ALLOWED_HOSTS=
